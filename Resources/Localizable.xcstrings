      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ built in"
          }
        }
      }
    },
    "%@ 只能由 Vapor 启动：它需要自己的 Wine 引擎。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ can only be launched by Vapor: it needs its own Wine engine."
          }
        }
      }
    },
    "%@ 在 %@ 下启动后很快退出了。可以在游戏详情页的“候选后端”里换一个再试。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ quit soon after launching with %2$@. Try another one under Candidate Backends on the game page."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ 在 %2$@ 下启动后很快退出了。可以在游戏详情页的“候选后端”里换一个再试。"
          }
        }
