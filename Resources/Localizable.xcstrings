        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " %@"
          }
        }
      }
    },
    " Vapor 启动游戏时也会带上这些参数。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Vapor also passes these arguments when it launches the game."
          }
        }
      }
    },
    "%.1f 小时" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%.1f hours"
          }
        }
      }
    },
    "%1$s 可用" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$s available"
          }
        }
      }
    },
    "%1$s 已存储" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$s stored"
          }
        }
      }
    },
    "%1$s 当前使用第三方软件来升级自己的文件。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$s is currently using third-party software to update its own files."
          }
        }
      }
    },
    "%@ %lld    %@ %lld" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %lld    %@ %lld"
