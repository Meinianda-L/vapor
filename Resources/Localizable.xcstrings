    "%@ 是内核级反作弊，无法在 Wine 中运行" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ uses kernel-level anti-cheat and cannot run in Wine"
          }
        }
      }
    },
    "%@ 校验失败，文件可能不完整，请重新下载。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ failed verification. The file may be incomplete; download it again."
          }
        }
      }
    },
    "%@ 没有装好。继续的话，%@ 可能无法正常运行。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is not installed correctly. If you continue, %2$@ may not run properly."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ 没有装好。继续的话，%2$@ 可能无法正常运行。"
