            "value" : "Apple's DirectX 11/12 translation"
          }
        }
      }
    },
    "CrossOver 的 wine 依赖 CrossOver 自己的启动环境（bottle 管理和授权检查），单独调用无法运行 Windows Steam。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrossOver's wine depends on CrossOver's own launch environment (bottle management and license checks) and cannot run Windows Steam when called on its own."
          }
        }
      }
    },
    "D3D10 直接转 Metal" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D3D10 translated directly to Metal"
          }
        }
      }
    },
    "D3D11 直接转 Metal" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D3D11 translated directly to Metal"
          }
        }
      }
    },
    "D3D12 只有 D3DMetal 能转译" : {
      "localizations" : {
