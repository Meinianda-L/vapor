      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vapor uses Windows Steam to download and run games, and presents them in a native Mac interface. It isn't on your Mac yet, so Vapor will now set everything up:"
